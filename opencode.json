{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/z-ai/glm-5.2",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git branch *": "allow",
      "git show *": "allow",
      "git commit *": "ask",
      "git push *": "ask",
      "git pull *": "ask",
      "git checkout *": "ask",
      "git switch *": "ask",
      "git merge *": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "ssh *": "ask",
      "docker *": "ask",
      "rm -rf *": "deny",
      "sudo rm *": "deny",
      "/usr/local/bin/teejarah-remote-status": "allow",
      "/usr/local/bin/teejarah-remote-logs *": "allow",
      "/usr/local/bin/teejarah-remote-sync": "ask",
      "/usr/local/bin/teejarah-remote-build": "ask",
      "/usr/local/bin/teejarah-remote-deploy": "ask",
      "/usr/local/bin/teejarah-nasdaq-check *": "allow"
    }
  },
  "small_model": "openrouter/z-ai/glm-5.3-flash",
  "agent": {
    "build": {
      "permission": {
        "task": {
          "*": "deny",
          "fast-review": "allow",
          "code-specialist": "ask",
          "premium-review": "ask"
        }
      }
    }
  }
}
